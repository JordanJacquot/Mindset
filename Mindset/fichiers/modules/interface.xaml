<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindset" Width="1340" Height="930" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#06050F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#ECEAF7"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Palette Néon, la même que Nevermind et Evermind -->
    <SolidColorBrush x:Key="Fond" Color="#06050F"/>
    <SolidColorBrush x:Key="Panneau" Color="#0C0920"/>
    <SolidColorBrush x:Key="Panneau2" Color="#141030"/>
    <SolidColorBrush x:Key="Trait" Color="#2A2450"/>
    <SolidColorBrush x:Key="Texte" Color="#ECEAF7"/>
    <SolidColorBrush x:Key="Texte2" Color="#A9A3C9"/>
    <SolidColorBrush x:Key="Texte3" Color="#6F6894"/>
    <LinearGradientBrush x:Key="Marque" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/>
      <GradientStop Color="#B04BFF" Offset="0.55"/>
      <GradientStop Color="#FF2EB5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Onglet de la barre de gauche -->
    <Style x:Key="Onglet" TargetType="Button">
      <Setter Property="Foreground" Value="#A9A3C9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,9" Margin="0,0,0,3">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#100C28"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cartes en verre, boutons : exactement ceux de Nevermind et Evermind -->
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#17FFFFFF" Offset="0"/>
      <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBg" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/>
      <GradientStop Color="#B04BFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBg}"/>
      <Setter Property="Foreground" Value="#08060F"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <!-- Reflet qui apparaît au survol -->
              <Border x:Name="Shine" CornerRadius="19" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Halo cyan au survol -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#16FFFFFF"/>
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#8000E5FF"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Interrupteur (le même que Nevermind) : le bouton glisse et la piste s'allume -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#3A4355">
              <Border.Background><SolidColorBrush x:Name="TrackBrush" Color="#2EFFFFFF"/></Border.Background>
              <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#EEEBF7" Stroke="#40000000" StrokeThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Le bouton glisse et la piste s'allume en douceur -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#7FF4FF"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#00D9F5" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fond : nuit violette et trois lueurs (cyan en haut à gauche, violet au centre, magenta en bas à droite),
         le même que Nevermind et Evermind -->
    <Grid Grid.RowSpan="3" IsHitTestVisible="False">
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C0920" Offset="0"/>
            <GradientStop Color="#06050F" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#4400E5FF" Offset="0"/>
            <GradientStop Color="#0000E5FF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.6,0.35" GradientOrigin="0.6,0.35" RadiusX="0.45" RadiusY="0.45">
            <GradientStop Color="#267A3CFF" Offset="0"/>
            <GradientStop Color="#007A3CFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.92,0.9" GradientOrigin="0.92,0.9" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#44FF2EB5" Offset="0"/>
            <GradientStop Color="#00FF2EB5" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- Fond d'un thème personnalisé (image et voile, packs.ps1), au-dessus des lueurs, derrière le reste -->
    <Grid x:Name="BackdropDeco" Grid.RowSpan="3" IsHitTestVisible="False"/>

    <!-- Dessin animé d'un thème personnalisé, en bas de la fenêtre (packs.ps1) -->
    <Border x:Name="FooterArt" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Left" Margin="16,0,0,4" IsHitTestVisible="False"/>

    <!-- En-tête : logo animé, nom et phrase, comme Nevermind et Evermind -->
    <DockPanel Grid.Row="0" Margin="24,16,28,10" LastChildFill="False">
      <TextBlock x:Name="Version" DockPanel.Dock="Right" Foreground="{StaticResource Texte3}" FontSize="12" VerticalAlignment="Center"/>
      <!-- Mascotte d'un thème personnalisé (packs.ps1) -->
      <Border x:Name="Mascotte" DockPanel.Dock="Right" Height="64" Margin="0,-10,22,-10" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      <!-- Logo (modules\logo.ps1) : dessiné en 84 px, affiché en 60 -->
      <Grid x:Name="LogoHote" DockPanel.Dock="Left" Width="84" Height="84" Margin="0,-6,10,-6" VerticalAlignment="Center" Background="Transparent">
        <Grid.LayoutTransform><ScaleTransform ScaleX="0.714" ScaleY="0.714"/></Grid.LayoutTransform>
      </Grid>
      <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
        <TextBlock Text="Mindset" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Toutes tes applis au même endroit." FontSize="15" Foreground="#A6A1BC" Margin="1,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Onglets : Accueil, puis une ligne par appli (ajoutées depuis apps.json) ; Paramètres en bas -->
      <Border Grid.Column="0" Background="#55060510" BorderBrush="#2A2450" BorderThickness="0,1,1,0" CornerRadius="0,14,0,0" Padding="10,14">
        <DockPanel>
          <StackPanel x:Name="OngletsBas" DockPanel.Dock="Bottom"/>
          <StackPanel x:Name="Onglets"/>
        </DockPanel>
      </Border>

      <!-- Zone centrale (transparente : le fond et ses lueurs passent derrière) -->
      <Border Grid.Column="1" Background="Transparent">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- Bandeaux (installer Mindset, mini-installateur, mise à jour de Mindset) : au-dessus de toutes les pages, console comprise -->
          <StackPanel x:Name="Bandeaux" Grid.Row="0" Margin="32,0,32,0">
          <!-- Mindset lancé depuis le dossier téléchargé : proposer de l'installer -->
          <Border x:Name="Bienvenue" Visibility="Collapsed" Background="{StaticResource CardBg}" BorderBrush="#8000E5FF" BorderThickness="1" CornerRadius="22" Padding="24,18" Margin="0,22,0,0" MaxWidth="770" HorizontalAlignment="Left">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="BtnBienvenuePlusTard" Content="Plus tard" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                <Button x:Name="BtnInstallerMindset" Content="Installer Mindset" Style="{StaticResource BtnPrimary}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Installer Mindset sur ce PC" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="BienvenueTexte" TextWrapping="Wrap" Foreground="#A9A3C9" Margin="0,4,0,0"
                           Text="Mindset s'installe avec ses applis et leurs données sur le disque choisi, crée son raccourci sur le Bureau et dans le menu Démarrer, et se lance avec Windows. Tu pourras ensuite supprimer le dossier téléchargé."/>
                <TextBlock Text="Où installer Mindset et ses applis ?" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
                <StackPanel x:Name="ChoixDisques"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Installation d'avant la 0.2 : activer Mindset en administrateur (tâches planifiées), pour accueillir Nevermind -->
          <Border x:Name="AdminBandeau" Visibility="Collapsed" Background="{StaticResource CardBg}" BorderBrush="#8000E5FF" BorderThickness="1" CornerRadius="22" Padding="24,16" Margin="0,22,0,0" MaxWidth="770" HorizontalAlignment="Left">
            <DockPanel>
              <Button x:Name="BtnActiverAdmin" DockPanel.Dock="Right" Content="Activer" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Installer sans demande de Windows" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="AdminTexte" TextWrapping="Wrap" Foreground="#A9A3C9" Margin="0,4,0,0"
                           Text="Mindset crée son mini-installateur : les installations et les mises à jour (seulement des fichiers signés) ne demanderont plus l'autorisation. Une dernière demande de Windows."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Mise à jour de Mindset : prête (téléchargée et vérifiée), ou résultat après la relance (mindset.ps1) -->
          <Border x:Name="MajBandeau" Visibility="Collapsed" Background="{StaticResource CardBg}" BorderBrush="#80B04BFF" BorderThickness="1" CornerRadius="22" Padding="24,16" Margin="0,22,0,0" MaxWidth="770" HorizontalAlignment="Left">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="BtnMajFermer" Content="OK" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                <Button x:Name="BtnMajMindset" Content="Redémarrer et mettre à jour" Style="{StaticResource BtnPrimary}"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MajTitre" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="MajTexte" TextWrapping="Wrap" Foreground="#A9A3C9" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          </StackPanel>

          <!-- La console 3D (console.ps1) : l'accueil de Mindset quand elle peut s'afficher ; sinon l'accueil classique ci-dessous -->
          <Grid x:Name="PageConsole" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="ConsoleAttente" Text="Allumage de la console..." Foreground="{StaticResource Texte3}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>

          <!-- Accueil -->
          <ScrollViewer x:Name="PageAccueil" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28">
              <!-- Bonjour, et « Actualiser » : chercher tout de suite les nouvelles versions (sans fermer Mindset) -->
              <DockPanel Margin="0,0,18,24">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="ActualiserInfo" Foreground="{StaticResource Texte3}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button x:Name="BtnActualiser" Content="Actualiser" Style="{StaticResource BtnSecondary}" ToolTip="Chercher les nouvelles versions de Mindset et de tes applis"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="Greeting" FontSize="26" FontWeight="SemiBold"/>
                  <TextBlock Text="Tes applis de la suite, au même endroit." Foreground="{StaticResource Texte2}" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
              <WrapPanel x:Name="Cartes"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Page d'une appli : sa vraie fenêtre, accrochée ici (integration.ps1), ou un message en attendant -->
          <Grid x:Name="PageAppli" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="PageAppliMessage" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
              <!-- Jauge de chargement pendant que l'appli s'ouvre (chargement.ps1) -->
              <Grid x:Name="PageAppliJauge" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
              <TextBlock x:Name="PageAppliTitre" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
              <TextBlock x:Name="PageAppliTexte" Foreground="{StaticResource Texte2}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPageAppliIci" Content="Afficher ici" Style="{StaticResource BtnPrimary}" Visibility="Collapsed" Margin="0,0,8,0"/>
              </StackPanel>
              <TextBlock x:Name="PageAppliEtat" Foreground="{StaticResource Texte3}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <DockPanel x:Name="PageAppliCadre" Margin="0,0,10,10" Visibility="Collapsed">
              <!-- Barre de l'appli affichée : la fermer (les applis ne s'ouvrent que dans Mindset) -->
              <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8" LastChildFill="False">
                <Button x:Name="BtnAppliFermer" DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource BtnSecondary}" Padding="14,6"/>
              </DockPanel>
              <Grid x:Name="PageAppliHotes"/>
            </DockPanel>
          </Grid>

          <!-- Paramètres : les réglages communs à toute la suite, en onglets (parametres.ps1) -->
          <DockPanel x:Name="PageParametres" Grid.Row="1" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Margin="32,22,32,0">
              <TextBlock Text="Paramètres" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="Ces réglages valent pour Mindset et toutes ses applis." Foreground="{StaticResource Texte2}" Margin="0,4,0,14"/>
              <WrapPanel x:Name="OngletsParametres"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="32,18,32,28" MaxWidth="780" HorizontalAlignment="Left">

                <!-- Général -->
                <StackPanel x:Name="PanGeneral">
                  <TextBlock Text="Réduire et fermer" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10"
                             Text="Caché près de l'horloge, Mindset continue de veiller sur tes applis : un clic sur son icône le rouvre."/>
                  <CheckBox x:Name="ReduireHorloge" Content="Réduire Mindset près de l'horloge (au lieu de la barre des tâches)" Foreground="#ECEAF7" Margin="0,0,0,10"/>
                  <TextBlock Text="Quand je clique sur la croix :" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <StackPanel x:Name="ChoixFermeture"/>

                  <TextBlock Text="Démarrage avec Windows" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10"
                             Text="Choisis si Mindset se lance avec Windows (caché près de l'horloge), et quelles applis s'ouvrent avec lui : elles démarrent en arrière-plan à chaque ouverture de Mindset (le même réglage que sur leur carte de l'accueil)."/>
                  <StackPanel x:Name="Demarrages"/>
                </StackPanel>

                <!-- Apparence -->
                <StackPanel x:Name="PanApparence" Visibility="Collapsed">
                  <TextBlock Text="Thème de la suite" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,14"
                             Text="Le même pour Mindset et toutes ses applis : le changer ici relance chaque appli ouverte avec ce thème."/>
                  <WrapPanel x:Name="Themes"/>
                  <TextBlock x:Name="ThemeInfo" Foreground="{StaticResource Texte3}" FontSize="12" Margin="0,6,0,0"/>
                  <Button x:Name="BtnImporterTheme" Content="Importer un thème (.zip)" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte3}" FontSize="12" Margin="0,8,0,0" Text="Un thème personnalisé de la suite (images, police, personnage) s'installe pour Mindset et toutes ses applis. Il reste sur ce PC."/>
                </StackPanel>

                <!-- Son -->
                <StackPanel x:Name="PanSon" Visibility="Collapsed">
                  <TextBlock Text="Micro" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10"
                             Text="Celui qu'Evermind écoute (dictée, « OK Evermind »). Débranché, c'est celui de Windows qui sert en attendant."/>
                  <StackPanel x:Name="ChoixMicro"/>
                  <TextBlock Text="Casque ou haut-parleurs" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10"
                             Text="Là où Evermind te parle et sonne tes rappels."/>
                  <StackPanel x:Name="ChoixCasque"/>
                  <Button x:Name="BtnSonActualiser" Content="Actualiser la liste" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Mises à jour -->
                <StackPanel x:Name="PanMaj" Visibility="Collapsed">
                  <TextBlock Text="Versions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,12"
                             Text="Mindset cherche les nouvelles versions au démarrage puis toutes les 6 heures. Elles sont signées : une version qui ne l'est pas n'est jamais installée."/>
                  <StackPanel x:Name="ListeVersions"/>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnVerifierMaj" Content="Vérifier maintenant" Style="{StaticResource BtnPrimary}"/>
                    <TextBlock x:Name="MajInfo" Foreground="{StaticResource Texte3}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                  </StackPanel>
                </StackPanel>

                <!-- Dossiers -->
                <StackPanel x:Name="PanDossiers" Visibility="Collapsed">
                  <TextBlock Text="Dossiers" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10" x:Name="DossiersTexte"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDossierProgrammes" Content="Ouvrir le dossier des programmes" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDossierDonnees" Content="Ouvrir le dossier des données" Style="{StaticResource BtnSecondary}"/>
                  </StackPanel>

                  <TextBlock Text="Désinstaller Mindset" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,4"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,10"
                             Text="Désinstalle d'abord les applis depuis l'accueil. Les données restent sur le PC : une réinstallation les retrouve."/>
                  <Button x:Name="BtnDesinstallerMindset" Content="Désinstaller Mindset" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- La croix rouge : réduire près de l'horloge ou quitter (zone.ps1) -->
    <Grid x:Name="Fermeture" Grid.RowSpan="3" Visibility="Collapsed" Background="#C006050F">
      <Border Background="{StaticResource Panneau2}" BorderBrush="{StaticResource Trait}" BorderThickness="1" CornerRadius="22"
              Padding="28,24" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Fermer Mindset ?" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Texte2}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Réduit près de l'horloge, Mindset et tes applis restent prêts : un clic sur son icône le rouvre. Quitter ferme aussi toutes tes applis (les rappels d'Evermind, par exemple, ne sonneront plus jusqu'à la réouverture)."/>
          <CheckBox x:Name="FermetureSouvenir" Content="Ne plus me demander (modifiable dans Paramètres)" Foreground="#ECEAF7" Margin="0,16,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnFermetureAnnuler" Content="Annuler" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
            <Button x:Name="BtnFermetureQuitter" Content="Tout quitter" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
            <Button x:Name="BtnFermetureReduire" Content="Réduire près de l'horloge" Style="{StaticResource BtnPrimary}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- « Êtes-vous sûr ? » : par dessus tout -->
    <Grid x:Name="Confirmation" Grid.RowSpan="3" Visibility="Collapsed" Background="#C006050F">
      <Border Background="{StaticResource Panneau2}" BorderBrush="{StaticResource Trait}" BorderThickness="1" CornerRadius="12"
              Padding="26,22" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ConfirmationTitre" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmationTexte" Foreground="{StaticResource Texte2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnConfirmationNon" Content="Annuler" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
            <Button x:Name="BtnConfirmationOui" Style="{StaticResource BtnPrimary}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
