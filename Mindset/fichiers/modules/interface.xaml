<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindset" Width="1180" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#06050F"
        FontFamily="Segoe UI" FontSize="14" Foreground="#ECEAF7"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Palette Néon, la même que Nevermind et Evermind -->
    <SolidColorBrush x:Key="Fond" Color="#06050F"/>
    <SolidColorBrush x:Key="Panneau" Color="#0C0920"/>
    <SolidColorBrush x:Key="Panneau2" Color="#141030"/>
    <SolidColorBrush x:Key="Trait" Color="#2A2450"/>
    <SolidColorBrush x:Key="Texte" Color="#ECEAF7"/>
    <SolidColorBrush x:Key="Texte2" Color="#A9A3C9"/>
    <SolidColorBrush x:Key="Texte3" Color="#6F6894"/>
    <LinearGradientBrush x:Key="Marque" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/>
      <GradientStop Color="#B04BFF" Offset="0.55"/>
      <GradientStop Color="#FF2EB5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Onglet de la barre de gauche -->
    <Style x:Key="Onglet" TargetType="Button">
      <Setter Property="Foreground" Value="#A9A3C9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,9" Margin="0,0,0,3">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#100C28"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boutons, même style que Nevermind et Evermind -->
    <Style x:Key="BtnSecondary" TargetType="Button">
      <Setter Property="Foreground" Value="#ECEAF7"/>
      <Setter Property="Background" Value="#141030"/>
      <Setter Property="BorderBrush" Value="#2A2450"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#00E5FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Foreground" Value="#06050F"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5FF" Offset="0"/>
            <GradientStop Color="#B04BFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- En-tête -->
    <Border Grid.Row="0" Background="{StaticResource Fond}" BorderBrush="{StaticResource Trait}" BorderThickness="0,0,0,1" Padding="18,12">
      <DockPanel LastChildFill="False">
        <Grid DockPanel.Dock="Left" Width="30" Height="30" VerticalAlignment="Center">
          <Ellipse Stroke="#1D1840" StrokeThickness="3"/>
          <Ellipse x:Name="LogoAnneau" StrokeThickness="3" StrokeDashArray="14 6" RenderTransformOrigin="0.5,0.5" Stroke="{StaticResource Marque}">
            <Ellipse.RenderTransform><RotateTransform x:Name="LogoRotation"/></Ellipse.RenderTransform>
          </Ellipse>
          <TextBlock Text="M" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ECEAF7"/>
        </Grid>
        <TextBlock DockPanel.Dock="Left" Text="Mindset" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Version" DockPanel.Dock="Right" Foreground="{StaticResource Texte3}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Onglets : Accueil, puis une ligne par appli (ajoutées depuis apps.json) ; Paramètres en bas -->
      <Border Grid.Column="0" Background="{StaticResource Fond}" BorderBrush="{StaticResource Trait}" BorderThickness="0,0,1,0" Padding="10,14">
        <DockPanel>
          <StackPanel x:Name="OngletsBas" DockPanel.Dock="Bottom"/>
          <StackPanel x:Name="Onglets"/>
        </DockPanel>
      </Border>

      <!-- Zone centrale -->
      <Border Grid.Column="1" Background="{StaticResource Panneau}">
        <Grid>
          <!-- Accueil -->
          <ScrollViewer x:Name="PageAccueil" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28">
              <TextBlock x:Name="Greeting" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="Tes applis de la suite, au même endroit." Foreground="{StaticResource Texte2}" Margin="0,4,0,24"/>
              <WrapPanel x:Name="Cartes"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Page d'une appli : c'est ici qu'elle s'affichera (phase C du plan) -->
          <Grid x:Name="PageAppli" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
              <TextBlock x:Name="PageAppliTitre" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PageAppliTexte" Foreground="{StaticResource Texte2}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18"/>
              <TextBlock x:Name="PageAppliEtat" Foreground="{StaticResource Texte3}" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- Paramètres -->
          <ScrollViewer x:Name="PageParametres" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Left">
              <TextBlock Text="Paramètres" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="Thème de la suite" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texte2}" Margin="0,0,0,14"
                         Text="Le même pour Mindset et pour les applis installées par Mindset : en changer ici les relance avec ce thème. Changer de thème dans Nevermind ou Evermind le change aussi ici."/>
              <WrapPanel x:Name="Themes"/>
              <TextBlock x:Name="ThemeInfo" Foreground="{StaticResource Texte3}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- « Êtes-vous sûr ? » : par dessus tout -->
    <Grid x:Name="Confirmation" Grid.RowSpan="2" Visibility="Collapsed" Background="#C006050F">
      <Border Background="{StaticResource Panneau2}" BorderBrush="{StaticResource Trait}" BorderThickness="1" CornerRadius="12"
              Padding="26,22" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ConfirmationTitre" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmationTexte" Foreground="{StaticResource Texte2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnConfirmationNon" Content="Annuler" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
            <Button x:Name="BtnConfirmationOui" Style="{StaticResource BtnPrimary}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
