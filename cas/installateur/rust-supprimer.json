    {"nom":"id d'appli mal formé : « Appli inconnue. », rien supprimé","entree":{"lancement":"tache","demande":{"Action":"supprimer","Destination":"{pm}\\Appli","Exe":"Appli.exe","Appli":"..\\appli"}},"attendu":{"reponse":"refus","message_exact":"Appli inconnue.","rien_fait":true}},
    {"nom":"Mindset lui-même avec Appli : « Dossier refusé », rien supprimé","entree":{"lancement":"tache","demande":{"Action":"supprimer","Destination":"{pm}\\Mindset","Appli":"appli"}},"attendu":{"reponse":"refus","message":"Dossier refusé","rien_fait":true}},
