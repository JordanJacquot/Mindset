{
  "format": 1,
  "sujet": "La demande lue par la tâche SYSTEM (Action demande) : taille, numéro, action, paramètres ignorés, dossier des programmes venu de la tâche",
  "regle": "installer-admin.ps1 -Action demande -Sid <utilisateur inscrit dans la tâche> -Demande <fichier écrit par Mindset sans droits>",
  "attendu": "voir cas\\LISEZMOI.md (reponse, message, rien_fait, actions, taches_creees...)",
  "valeurs": {
    "{tmp}": "le dossier du faux PC",
    "{pm}": "Program Files\\Mindset du faux PC ({tmp}\\ProgramFiles\\Mindset)",
    "{x}": "la lettre du faux disque fixe NTFS (sans les deux points)",
    "{zip-appli}": "le zip signé de l'appli de test (2.0.0), dans le dossier telechargements de l'utilisateur",
    "{zip-mindset}": "le zip signé de Mindset (2.0.0), dans le même dossier",
    "{src-ok}": "un dossier source de Mindset complet",
    "{sid}": "l'utilisateur inscrit dans la tâche (celui qui fait tourner le test)",
    "{sid-autre}": "un autre compte du PC",
    "{id}": "un numéro de demande neuf, le même dans tout le cas"
  },
  "cas": [
